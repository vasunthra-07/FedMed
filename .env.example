# =============================================================================
# .env.example  —  FedMed Environment Configuration Template
# =============================================================================
# Copy to .env and fill in real values BEFORE running in production.
# NEVER commit .env to git — it is in .gitignore.
# In production, inject these via your secrets manager (AWS Secrets Manager,
# HashiCorp Vault, Kubernetes Secrets, etc.)
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
FEDMED_SERVER_HOST=0.0.0.0
FEDMED_SERVER_PORT=8080
FEDMED_NUM_ROUNDS=10
FEDMED_MIN_CLIENTS=2

# ── Security ──────────────────────────────────────────────────────────────────
FEDMED_USE_TLS=true

# CRITICAL: Use a cryptographically random 64-char secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FEDMED_JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_SECRET

FEDMED_JWT_EXPIRY_HOURS=8

# ── Dashboard credentials ─────────────────────────────────────────────────────
FEDMED_DASH_USER=admin

# bcrypt hash of your dashboard password.
# Generate with: python -c "from security import hash_password; print(hash_password('yourpassword'))"
FEDMED_DASH_PASS_HASH=$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH_OF_YOUR_PASSWORD

# ── Differential Privacy ──────────────────────────────────────────────────────
FEDMED_DP_NOISE=1.2
FEDMED_DP_CLIP=1.0
FEDMED_DP_DELTA=1e-5

# ── FedProx ───────────────────────────────────────────────────────────────────
FEDMED_MU=0.01
FEDMED_LOCAL_EPOCHS=3
FEDMED_BATCH_SIZE=32
FEDMED_LR=0.01

# ── Data ──────────────────────────────────────────────────────────────────────
FEDMED_NUM_WORKERS=4
FEDMED_SAMPLES_PER_CLIENT=2000
FEDMED_BIAS_FRACTION=0.75
FEDMED_DOWNLOAD=true

# ── Checkpointing ─────────────────────────────────────────────────────────────
FEDMED_RESUME=false
FEDMED_CHECKPOINT_EVERY=1
FEDMED_KEEP_CHECKPOINTS=3

# ── Logging ───────────────────────────────────────────────────────────────────
FEDMED_LOG_LEVEL=INFO

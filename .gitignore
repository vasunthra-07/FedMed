# FedMed local and generated files

# Secrets - never commit these.
.env
*.key
*.pem
certs/

# Runtime state generated by server/client runs.
metrics.csv
telemetry.jsonl
status.json
status.tmp
mu_config.json
checkpoints/
logs/

# Python build and cache files.
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments.
.venv/
.venv*/
venv/
env/

# Testing and coverage.
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Linting/type-checking caches.
.ruff_cache/
.mypy_cache/

# Dataset caches and future prediction artifacts.
~/.medmnist/
*.npz
results/predictions/

# Local benchmark logs.
results/*_run.log
results/*_stdout.log

# IDE and OS metadata.
.vscode/
.idea/
*.swp
*.swo
.DS_Store
